PORT=8080
DATABASE_URL=postgresql://loadfinder:loadfinder@localhost:5432/loadfinder
REDIS_URL=redis://localhost:6379
AUTH_JWKS_URL=https://YOUR-ISSUER/.well-known/jwks.json
AUTH_ISSUER=https://identity.example.com/realms/loadfinder
AUTH_AUDIENCE=loadfinder-api
TOKEN_ENCRYPTION_KEY=replace-with-high-entropy-secret
AUTO_BID_LIVE=false
TRANS_EU_CLIENT_ID=
TRANS_EU_CLIENT_SECRET=
TRANS_EU_API_KEY=
TRANS_EU_REDIRECT_URI=http://localhost:8080/v1/exchanges/trans-eu/callback
PUSH_PROVIDER=disabled
# For a configured worker use PUSH_PROVIDER=firebase and Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
